{
  "version": 8,
  "name": "SubsurfaceExplorer — OSM base",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0B1725" } },
    { "id": "osm-raster", "type": "raster", "source": "osm", "paint": { "raster-opacity": 0.96 } }
  ]
}
